# GEMINI_API_KEY: Required for Gemini AI scripts, TTS voices, and Veo/Omni video + Imagen/Lyria when billing-enabled.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# RUNWAY_API_KEY: Optional. Official RunwayML API key for Runway Gen-4 / Gen-3 video generation adapter.
RUNWAY_API_KEY=""

# STRIPE_SECRET_KEY: Optional. Server-side Stripe secret key for live subscription checkout sessions.
STRIPE_SECRET_KEY=""

# STRIPE_WEBHOOK_SECRET: Optional. Stripe webhook signing secret for verifying subscription events.
STRIPE_WEBHOOK_SECRET=""

# ADMIN_PASSCODE: Optional. Server-side administrator claim/login passcode (overrides first-run admin setup when set).
ADMIN_PASSCODE=""

# STORAGE_DIR: Optional. Directory for SQLite database and generated MP4/WAV/PNG media files (defaults to ./data).
STORAGE_DIR=""
